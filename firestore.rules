rules_version = '2';

// Règles de la base Firestore de Zynora : à coller dans la console Firebase
// (Firestore Database > Règles). Chacun ne lit et n'écrit que sa propre fiche,
// et personne ne peut s'attribuer Premium ou VIP depuis l'appli.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['vip', 'premium']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['vip', 'premium']);

      // favorites, history, et xtream (URL, identifiant et mot de passe du fournisseur
      // IPTV si l'utilisateur l'a choisi) : lisibles par leur seul propriétaire.
      match /library/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
